{
  "name": "flux-rush-mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "lint": "eslint .",
    "test": "jest",
    "ts:check": "tsc --noEmit",
    "pods": "cd ios && bundle exec pod install && cd ..",
    "clean": "cd android && ./gradlew clean",
    "build:apk": "cd android && ./gradlew assembleRelease",
    "build:aab": "cd android && ./gradlew bundleRelease",
    "build:dev-apk": "npx react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res/ && cd android && gradlew assembleDebug --no-problems-report",
    "android:release-apk": "cd android && gradlew.bat assembleRelease",
    "android:release-aab": "cd android && gradlew.bat bundleRelease",
    "android:signingReport": "cd android && gradlew.bat signingReport",
    "release:android": "react-native run-android --mode=release",
    "release:ios": "react-native run-ios --mode Release",
    "version:bump": "npm version patch"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@shopify/react-native-skia": "2.11.0",
    "react": "19.2.3",
    "react-native": "0.87.0",
    "react-native-haptic-feedback": "3.0.0",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "0.37.0",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-sound": "0.13.0",
    "react-native-vision-camera": "5.2.3",
    "react-native-worklets": "0.12.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.0",
    "@react-native/eslint-config": "0.87.0",
    "@react-native/jest-preset": "0.87.0",
    "@react-native/metro-config": "0.87.0",
    "@react-native/typescript-config": "0.87.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "packageManager": "yarn@4.17.0"
}
